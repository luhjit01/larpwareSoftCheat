{
  "name": "sjtweaks-premium-3.0",
  "version": "1.0.0",
  "description": "SJTweaks Premium - The ultimate heavy duty Windows optimization utility",
  "main": "main.js",
  "author": "SJTweaks",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "globe.gl": "^2.45.0",
    "node-machine-id": "^1.1.12",
    "sudo-prompt": "^9.2.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sjtweaks.premium",
    "productName": "SJTweaks Premium",
    "win": {
      "target": ["nsis"],
      "icon": "applogo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "license.html",
      "node_modules/**/*"
    ]
  }
}
